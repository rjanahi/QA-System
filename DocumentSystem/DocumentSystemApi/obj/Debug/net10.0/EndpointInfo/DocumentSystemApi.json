  "components": {
    "schemas": {
      "GenerateSummaryDto": {
        "required": [
          "analysisId",
          "summaryType"
        ],
        "type": "object",
        "properties": {
          "analysisId": {
            "type": "string",
            "format": "uuid"
          },
          "summaryType": {
            "pattern": "^(General|Technical|Executive)$",
            "type": "string"
          }
        }
      },
      "LoginDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RegisterDto": {
        "required": [
          "fullName",
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "maxLength": 256,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "minLength": 8,
            "type": "string"
          }
        }
      }
    }
  },
